rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Common validation for all registry objects
    function isValidStatus(status) {
      return status is list && status.size() <= 10;
    }

    // Registry level access (for now, allow signed in users to manage registries)
    // In a real app, you'd likely have ownership or membership
    match /registries/{registryId} {
      allow read, write: if true;

      match /domains/{domainName} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }

      match /contacts/{contactId} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }

      match /hosts/{hostName} {
        allow read: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if true;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
